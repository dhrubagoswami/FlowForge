DATABASE_URL=
REDIS_URL=               # Local dev: redis://127.0.0.1:6379 (self-hosted). Deployed: a hosted
                          # Redis URL. See server/.env.example for the full explanation — do not
                          # point local dev at a hosted free tier.
WORKER_ID=               # blank = auto-generate
WORKER_CONCURRENCY=4
EXPECTED_WORKER_FLEET_SIZE=1     # how many live worker instances is normal — the boot-time census
                                 # logs a warning (not an error) if the instance-lock registry sees
                                 # more than this, e.g. if you deliberately run several workers
HEARTBEAT_INTERVAL_MS=5000
SHUTDOWN_GRACE_MS=30000
LOG_LEVEL=info
