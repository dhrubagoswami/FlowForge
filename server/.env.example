DATABASE_URL=            # Postgres connection string
REDIS_URL=               # Redis connection string
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
GEMINI_API_KEY=          # from Google AI Studio — see SETUP.md
GEMINI_MODEL=gemini-3.5-flash-lite   # model IDs and free-tier limits change over time — check
                                      # Google's current docs and swap this value, no code change needed
AI_CACHE_TTL_SECONDS=3600            # how long a compose/diagnose response is cached, keyed by input hash
AI_MAX_OUTPUT_TOKENS=2048            # cap on Gemini's response size
AI_TEMPERATURE=0.2                   # low = more deterministic JobConfig output
AI_RATE_LIMIT_PER_MIN=5              # max /api/ai/* requests per IP per window
AI_RATE_LIMIT_WINDOW_MS=60000
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173
