DATABASE_URL=            # Postgres connection string
REDIS_URL=               # Redis connection string.
                          # Local dev: redis://127.0.0.1:6379 (self-hosted — Memurai on Windows,
                          #   redis-server on Linux/WSL/macOS; see SETUP.md).
                          # Deployed: a hosted Redis URL (Upstash or equivalent) — reserved for
                          #   deployed environments only. Do not point local dev at a hosted free
                          #   tier: idle BullMQ polling has a real, ongoing command cost even with
                          #   no jobs running, and a hosted free tier can be exhausted just by
                          #   leaving a dev server/worker running (see DECISIONS.md).
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
GEMINI_API_KEY=          # from Google AI Studio — see SETUP.md
GEMINI_MODEL=gemini-3.5-flash-lite   # model IDs and free-tier limits change over time — check
                                      # Google's current docs and swap this value, no code change needed
AI_CACHE_TTL_SECONDS=3600            # how long a compose/diagnose response is cached, keyed by input hash
AI_MAX_OUTPUT_TOKENS=2048            # cap on Gemini's response size
AI_TEMPERATURE=0.2                   # low = more deterministic JobConfig output
AI_RATE_LIMIT_PER_MIN=5              # max /api/ai/* requests per IP per window
AI_RATE_LIMIT_WINDOW_MS=60000
DEMO_MODE=true
DEMO_RATE_LIMIT_PER_MIN=10           # max /api/demo/* requests per IP per window
DEMO_RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:5173
